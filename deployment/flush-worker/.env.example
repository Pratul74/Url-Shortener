# Flush worker config.
# Postgres, Redis and RabbitMQ each run on their own server,
# so each has its own host. Use private IPs or DNS names.

# --- Database ---
DATABASE_URL=postgresql://user:password@postgres-host:5432/url_shortener_db?sslmode=require

# --- Redis ---
REDIS_HOST=replace_with_redis_host
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_redis_password

# --- RabbitMQ ---
RABBITMQ_HOST=replace_with_rabbitmq_host
RABBITMQ_PORT=5672
RABBITMQ_USER=replace_with_rabbitmq_user
RABBITMQ_PASS=replace_with_rabbitmq_password
RABBITMQ_EXCHANGE=clicks.events
RABBITMQ_QUEUE=analytics.click
RABBITMQ_ROUTING_KEY=analytics.click

# --- GeoIP (only if the worker resolves locations) ---
GEOLITE2_PATH=./data/GeoLite2-City.mmdb