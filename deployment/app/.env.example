#Config for production level

# --- Database ---
DATABASE_URL=postgresql://username:password@postgres:5432/url_shortener_db

# --- RabbitMQ ---
RABBITMQ_HOST=replace_with_your_rabbitmq_host
RABBITMQ_PORT=5672
RABBITMQ_USER=your_rabbitmq_user
RABBITMQ_PASS=your_rabbitmq_password
RABBITMQ_EXCHANGE=clicks.events
RABBITMQ_QUEUE=analytics.click
RABBITMQ_ROUTING_KEY=analytics.click

# --- Redis ---
REDIS_HOST=replace_with_your_redis_host
REDIS_PORT=6379
# Optional: set if Redis has requirepass enabled (recommended)
REDIS_PASSWORD=replace_with_your_redis_password
REDIS_CACHE_TTL_SECONDS=86400


# --- App ---
# Public base URL of the app, e.g. https://snipp.pratulkumar.online
BASE_URL=your_domain_url

# Generate with: openssl rand -hex 32
SECRET_KEY=replace_with_a_long_random_string

# --- GeoIP ---
# Path inside the container: the geoipupdate service writes the database to the
# shared "geoip" volume, mounted at /usr/share/GeoIP.
GEOLITE2_PATH=/usr/share/GeoIP/GeoLite2-City.mmdb

# --- CORS ---
# Comma-separated list of allowed frontend origins
FRONTEND_ORIGINS=your_domain_url, http://localhost:3000

# --- AWS S3 (QR code storage) ---
AWS_REGION=replace_with_your_aws_region
S3_BUCKET=replace_with_your_bucket_name
# Optional: leave unset to use the default AWS credential chain (e.g. an IAM role)
ACCESS_KEY=replace_with_your_aws_iam_access_key
SECRET_ACCESS_KEY=replace_with_your_aws_iam_secret_access_key
