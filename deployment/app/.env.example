#Config for production level

# --- Database ---
DATABASE_URL=postgresql://username:password@postgres:5432/url_shortener_db

# --- RabbitMQ ---
RABBITMQ_HOST=5672
RABBITMQ_USER=your_rabbitmq_user
RABBITMQ_PASS=your_rabbitmq_password
RABBITMQ_EXCHANGE=clicks.events
RABBITMQ_QUEUE=analytics.click
RABBITMQ_ROUTING_KEY=analytics.click

# --- Redis ---
REDIS_HOST=replace_with_your_redis_host
REDIS_PORT=6379
REDIS_CACHE_TTL_SECONDS= replace_with_your_redis_custom_ttl


# --- App ---
# Public base URL of the app, e.g. https://snipp.pratulkumar.online
BASE_URL=your_domain_url

# Generate with: openssl rand -hex 32
SECRET_KEY=replace_with_a_long_random_string

# --- GeoIP ---
# Download GeoLite2-City.mmdb from MaxMind (free account required)
# Don't commit the .mmdb file; add it to .gitignore
GEOLITE2_PATH=./data/GeoLite2-City.mmdb

# --- CORS ---
# Comma-separated list of allowed frontend origins
FRONTEND_ORIGINS=your_domain_url, http://localhost:3000