# Local config file

# --- Database ---
DATABASE_URL=postgresql://username:password@localhost:5432/url_shortener_db

# --- App ---
# Public base URL of the app, e.g. http://localhost:8000
BASE_URL=your_base_url

# Generate with: openssl rand -hex 32
SECRET_KEY=replace_with_a_long_random_string

# --- GeoIP ---
# Download GeoLite2-City.mmdb from MaxMind (free account required)
# Don't commit the .mmdb file; add it to .gitignore
GEOLITE2_PATH=./data/GeoLite2-City.mmdb

# --- Redis ---
REDIS_PORT=6379
REDIS_HOST=localhost

# --- Rabbitmq ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=replace_with_your_rabbitmq_user
RABBITMQ_PASS=replace_with_your_rabbitmq_password

RABBITMQ_EXCHANGE=clicks.events
RABBITMQ_QUEUE=analytics.click
RABBITMQ_ROUTING_KEY=analytics.click

# --- CORS ---
# Comma-separated list of allowed frontend origins
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
